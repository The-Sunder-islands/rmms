}

// ═════════════════════════════════════════════════════════════════════════════
// SECTION 11: Plugin Request/Response
// ═════════════════════════════════════════════════════════════════════════════

table PluginDescriptor {
    id:                string;
    category:          PluginCategory;
    path:              string;      // .so path or executable path
    entry:             string;      // function name (EMBED) or argv (PROCESS)
    has_params:        bool;
    param_schema:      [ParamDef];
    has_audio_in:      bool;
    has_audio_out:     bool;
    has_midi_in:       bool;
    has_midi_out:      bool;
    max_latency_samples: uint32;
    name:              string;
    vendor:            string;
    version:           string;
}

// Method: "plugin.list"
table PluginListRequest {}
table PluginListResponse {
    plugins: [PluginDescriptor];
}

// Method: "plugin.get_descriptor"
table PluginGetDescriptorRequest {
    plugin_id: string;
}
table PluginGetDescriptorResponse {
    status:     StatusResponse;
    descriptor: PluginDescriptor;
}

// Method: "plugin.set_param"
table PluginSetParamRequest {
    plugin_id: string;
    key:       string;
    value:     string;      // JSON-encoded value
}
table PluginSetParamResponse {
    status: StatusResponse;
}

// Method: "plugin.get_params"
table PluginGetParamsRequest {
    plugin_id: string;
}
table PluginGetParamsResponse {
    status: StatusResponse;
    params: string;         // JSON-encoded key-value map
}

// Method: "plugin.enable"
table PluginEnableRequest {
    plugin_id: string;
    enabled:   bool;
}
table PluginEnableResponse {
    status: StatusResponse;
}

