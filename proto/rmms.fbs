// ═════════════════════════════════════════════════════════════════════════════
// SECTION 17: AI Types (mapped from Protocol B JSON schema)
// ═════════════════════════════════════════════════════════════════════════════

// --- ParamDef (drives dynamic UI generation) ---
table EnumOption {
    value: string;
    label: string;
}

table ParamDef {
    key:         string;
    type:        ParamType;
    label:       string;
    description: string;
    default_val: string;      // JSON-encoded default
    min:         float32;     // only for INT/FLOAT
    max:         float32;
    step:        float32;     // only for INT/FLOAT
    decimals:    uint8;       // only for FLOAT
    placeholder: string;      // only for STRING
    pattern:     string;      // only for STRING
    options:     [EnumOption];// only for ENUM/MULTI_ENUM
    group:       string;      // "basic" | "advanced" | "experimental"
}

// --- Device info (maps to /capabilities → devices[].units[]) ---
table AIDeviceUnit {
    device_index:    int32;
    name:            string;
    memory_total_mb: uint64;
}

table AIDevice {
    device_type:  DeviceType;
    available:    bool;
    count:        int32;
    install_hint: string;     // null = ""
    units:        [AIDeviceUnit];
}

// --- Scheduler config ---
table AIScheduler {
    max_concurrent_tasks: uint32;
    max_queue_size:       uint32;
}

// --- AI Capability ---
table AICapability {
    id:            string;
    label:         string;
    description:   string;
    status:        CapabilityStatus;
    models:        [string];
    default_model: string;    // empty = null
    param_defs:    [ParamDef];
}

// --- AI Capabilities response (maps to GET /api/v1/capabilities) ---
table AICapabilities {
    protocol_version: string;
    server_version:   string;
    capabilities:     [AICapability];
    devices:          [AIDevice];
    scheduler:        AIScheduler;
    output_formats:   [string];
    output_packages:  [string];
    max_upload_bytes: uint64;
}

// --- Pipeline step input ---
table AIStepInput {
    from_step: int32;
    stem:      string;     // empty = full output
}

// --- Pipeline step ---
table AIStep {
    type:         string;    // "split" | "midi" | "generate" | "detect"
    model:        string;
    input:        AIStepInput;
    params:       string;    // JSON-encoded key-value
    model_params: string;    // JSON-encoded, passed through to model
}

// --- Pipeline ---
table AIPipeline {
    steps: [AIStep];
}

// --- AI Request/Response methods ---

// Method: "ai.get_capabilities"
table AIGetCapabilitiesRequest {}
table AIGetCapabilitiesResponse {
    status:       StatusResponse;
    capabilities: AICapabilities;
}

// Method: "ai.submit_pipeline"
table AISubmitPipelineRequest {
    input_url:       string;
    pipeline:        AIPipeline;
    device_pref:     string;   // "npu" | "cuda" | "cpu"
    device_index:    int32;    // -1 = auto
    priority:        int32;    // 1-10, default 5
    output_format:   string;   // Protocol B string: "wav" | "flac" | "mp3"
    output_package:  string;   // Protocol B string: "separate" | "zip"
    force_refresh:   bool;
}
table AISubmitPipelineResponse {
    status:     StatusResponse;
    task_id:    string;
    cached:     bool;
    task_status:TaskStatus;
}

// Method: "ai.get_task_status"
table AIGetTaskStatusRequest {
    task_id: string;
}
table AIGetTaskStatusResponse {
    status:          StatusResponse;
    task_id:         string;
    task_status:     TaskStatus;
    current_step:    int32;
    step_type:       string;
    percent:         int32;
    completed_steps: [int32];
    failed_steps:    [int32];
    completed_urls:  [string];   // JSON-encoded StepResult array
    errors:          [string];   // JSON-encoded StepError array
}

// Method: "ai.cancel_task"
table AICancelTaskRequest {
    task_id: string;
}
table AICancelTaskResponse {
    status: StatusResponse;
}

// Method: "ai.list_tasks"
table AIListTasksRequest {
    status_filter: string;    // "" = all
    limit:         int32;
    offset:        int32;
}
table AIListTasksResponse {
    status: StatusResponse;
    tasks:  [string];         // JSON-encoded TaskSummary array
    total:  int32;
}

// --- AI SSE → FlatBuffers event translation ---

// Event: "ai.partial_result"
// Maps to SSE partial_result event (one per output stem)
table AIEventPartialResult {
    task_id:    string;
    step_index: int32;
    step_type:  string;
    stem:       string;
    track_type: string;      // "audio" | "midi" | "hybrid"
    label:      string;
    url:        string;
    format:     string;      // "wav" | "flac" | "mp3" | "mid"
    sample_rate:int32;
    duration:   float64;
    size_bytes: int64;
}

// Event: "ai.progress"
// Maps to SSE progress event
table AIEventProgress {
    task_id:    string;
    step_index: int32;
    step_type:  string;
    status:     StepStatus;
    percent:    int32;
    urls:       [string];
    error_code: string;
    error_msg:  string;
}

// Event: "ai.final_result"
// Maps to SSE final_result event
table AIEventFinalResult {
    task_id:    string;
    status:     TaskStatus;   // DONE | PARTIAL_ERROR | ERROR | CANCELLED
    urls:       [string];     // JSON-encoded StepResult array
    errors:     [string];     // JSON-encoded StepError array
}

// ═════════════════════════════════════════════════════════════════════════════
// SECTION 18: Event Tables (Backend → Frontend push)
// ═════════════════════════════════════════════════════════════════════════════

// Event: "transport.position_changed"  (~60 Hz via RingBuf)
table EventPositionChanged {
    tick: uint64;
}

// Event: "transport.state_changed"
table EventStateChanged {
    state: TransportState;
}

// Event: "meter.level_changed"  (~30 Hz via RingBuf)
table EventMeterLevel {
    channel_id: string;
    levels:     [float32];   // per-channel level in dB
}

// Event: "project.modified"
table EventProjectModified {
    modified: bool;
}

// Event: "track.added"
table EventTrackAdded {
    track: Track;
}

// Event: "track.removed"
table EventTrackRemoved {
    track_id: string;
}

// Event: "track.updated"
table EventTrackUpdated {
    track: Track;
}

// Event: "clip.added"
table EventClipAdded {
    clip: Clip;
}

// Event: "clip.removed"
table EventClipRemoved {
    clip_id: string;
}

// Event: "clip.updated"
table EventClipUpdated {
    clip: Clip;
}

// Event: "note.added"
table EventNoteAdded {
    note: Note;
}

// Event: "note.removed"
table EventNoteRemoved {
    note_id: string;
}

// Event: "note.updated"
table EventNoteUpdated {
    note: Note;
}

// Event: "plugin.status_changed"
table EventPluginStatusChanged {
    plugin_id: string;
    status:    PluginStatus;
}

// Event: "project.saved"
table EventProjectSaved {
    file_path: string;
}

// ═════════════════════════════════════════════════════════════════════════════
// SECTION 19: Message Envelope (Root Type)
// ═════════════════════════════════════════════════════════════════════════════

// The envelope is the top-level container for all messages.
// payload contains a serialized FlatBuffers table determined by `method`.
//
// For Requests:  payload = serialized *Request table
// For Responses: payload = serialized *Response table
// For Events:    payload = serialized Event* table
//
// v1 uses [ubyte] for simplicity; v2 will upgrade to a union type.

table Envelope {
    msg_type: MsgType;
    seq_id:   uint32;
    method:   string;       // e.g. "transport.play", "track.add", "ai.submit_pipeline"
    payload:  [ubyte];      // serialized FlatBuffers body
}

root_type Envelope;
