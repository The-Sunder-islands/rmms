// =============================================================================
// RMMS Protocol Schema — FlatBuffers IDL
// Version: 0.1.0 (Phase 0 draft)
//
// This is the single source of truth for all RMMS agent communication.
// Changes to this file require regenerating bindings and notifying all agents.
//
// Method naming convention: "{domain}.{action}"  (e.g. "transport.play")
// =============================================================================

namespace rmms;

// ═════════════════════════════════════════════════════════════════════════════
// SECTION 1: Core Enums
// ═════════════════════════════════════════════════════════════════════════════

// --- Message envelope type ---
enum MsgType : uint8 {
    REQUEST  = 0,
    RESPONSE = 1,
    EVENT    = 2,
}

// --- Plugin categories ---
enum PluginCategory : uint8 {
    EMBED   = 0,
    THREAD  = 1,
    PROCESS = 2,
}

// --- Track types ---
enum TrackType : uint8 {
    INSTRUMENT = 0,
    AUDIO      = 1,
    HYBRID     = 2,
    CHORD      = 3,
    ARRANGER   = 4,
    MARKER     = 5,
    TEMPO      = 6,
    GROUP      = 7,
}

// --- Clip types ---
enum ClipType : uint8 {
    MIDI       = 0,
    AUDIO      = 1,
    AUTOMATION = 2,
    HYBRID     = 3,
}

// --- Transport state ---
enum TransportState : uint8 {
    STOPPED = 0,
    PLAYING = 1,
    PAUSED  = 2,
}

// --- Chord types ---
enum ChordType : uint8 {
    MAJOR     = 0,
    MINOR     = 1,
    DIM       = 2,
    AUG       = 3,
    DOM7      = 4,
    MIN7      = 5,
    MAJ7      = 6,
    DIM7      = 7,
    HALF_DIM7 = 8,
    MIN_MAJ7  = 9,
    SUS2      = 10,
    SUS4      = 11,
    DOM9      = 12,
    MAJ9      = 13,
    MIN9      = 14,
}

// --- Marker types ---
enum MarkerType : uint8 {
    POINT      = 0,
    LOOP_START = 1,
    LOOP_END   = 2,
    REGION     = 3,
}

// --- AI capability implementation status ---
enum CapabilityStatus : uint8 {
    IMPLEMENTED     = 0,
    NOT_IMPLEMENTED = 1,
}

// --- AI Step status (progress events) ---
enum StepStatus : uint8 {
    RUNNING   = 0,
    COMPLETED = 1,
    FAILED    = 2,
}

// --- AI Task status ---
enum TaskStatus : uint8 {
    QUEUED        = 0,
    PROCESSING    = 1,
    DONE          = 2,
    PARTIAL_ERROR = 3,
    ERROR         = 4,
    CANCELLED     = 5,
}

// --- Plugin status ---
enum PluginStatus : uint8 {
    READY    = 0,
    LOADING  = 1,
    CRASHED  = 2,
    DISABLED = 3,
}

// --- Parameter type (for dynamic UI generation) ---
enum ParamType : uint8 {
    INT        = 0,
    FLOAT      = 1,
    STRING     = 2,
    ENUM       = 3,
    BOOL       = 4,
    MULTI_ENUM = 5,
}

// --- AI Device type ---
enum DeviceType : uint8 {
    NPU  = 0,
    CUDA = 1,
    CPU  = 2,
    MPS  = 3,
}

// NOTE: output_format and output_package are kept as strings (not enums)
// because Protocol B (AI Server REST API) uses string identifiers ("wav", "flac",
// "mp3", "separate", "zip"). The ai_client translation layer passes them through.

// ═════════════════════════════════════════════════════════════════════════════
// SECTION 2: Common / Shared Tables
// ═════════════════════════════════════════════════════════════════════════════

table StatusResponse {
    success:      bool;
    error_code:   string;     // empty on success
    error_message:string;     // empty on success
}

// ═════════════════════════════════════════════════════════════════════════════
// SECTION 3: Core Data Structures
// ═════════════════════════════════════════════════════════════════════════════

table Project {
    name:        string;
    file_path:   string;       // empty if unsaved
    bpm:         float32;
    time_sig_num:uint32;
    time_sig_den:uint32;
    sample_rate: uint32;
    modified:    bool;
}

table Track {
    id:          string;       // UUID
    name:        string;
    type:        TrackType;
    volume:      float32;
    pan:         float32;
    mute:        bool;
    solo:        bool;
    arm:         bool;
    color:       uint32;       // RGBA
    plugin_id:   string;       // InstrumentTrack: plugin UUID
    audio_url:   string;       // AudioTrack: file path or URL
    child_ids:   [string];     // GroupTrack: child track UUIDs
}

table Clip {
    id:          string;
    track_id:    string;
    type:        ClipType;
    start_tick:  uint64;
    length_ticks:uint64;
    loop_start:  uint64;       // 0 = no loop
    loop_end:    uint64;
}

table Note {
    id:          string;
    clip_id:     string;
    key:         uint8;        // 0-127 MIDI note
    start_tick:  uint64;
    length_ticks:uint64;
    velocity:    uint8;        // 0-127
    pan:         uint8;        // 0-127, 64 = center
}

table AutomationPoint {
    tick:        uint64;
    value:       float32;
}

// ═════════════════════════════════════════════════════════════════════════════
// SECTION 4: Specialized Track / Clip Structures
// ═════════════════════════════════════════════════════════════════════════════

// --- Hybrid Track (based on ripx_rip format) ---
table HarmonicEntry {
    harmonic_index: uint8;
    frequency:      float32;
    amplitude:      float32;
    phase:          float32;
    panning:        float32;
}

table NoteDescriptor {
    note_index:   uint32;
    channel:      uint8;
    start_frame:  uint32;
    end_frame:    uint32;
    frequency:    float32;
    amplitude:    float32;
    phase:        float32;
    panning:      float32;
    instrument:   uint8;
    harmonics:    [HarmonicEntry];
}

table HybridClip {
    clip:               Clip;      // composition: base clip fields
    waveform_url:       string;
    notes:              [NoteDescriptor];
    freq_trajectories:  [float32];  // N×M matrix, transmitted via shared memory
    amp_trajectories:   [float32];
    pan_trajectories:   [float32];
}

// --- Chord Track ---
table ChordEvent {
    id:        string;     // UUID
    tick:      uint64;
    root:      uint8;      // 0-11 (=C-B)
    type:      ChordType;
    duration:  uint64;     // in ticks
}

// --- Arranger Track ---
table ArrangerSection {
    id:           string;  // UUID
    name:         string;
    start_tick:   uint64;
    length_ticks: uint64;
    color:        uint32;
    repeat_count: uint32;  // 0 = no repeat
}

// --- Marker Track ---
table Marker {
    id:   string;          // UUID
    name: string;
    tick: uint64;
    type: MarkerType;
}

// --- Tempo Track ---
table TempoPoint {
    id:   string;          // UUID
    tick: uint64;
    bpm:  float32;
}

// ═════════════════════════════════════════════════════════════════════════════
// SECTION 5: Transport Request/Response
// ═════════════════════════════════════════════════════════════════════════════

// Method: "transport.play"
table TransportPlayRequest {}
table TransportPlayResponse {
    status:   StatusResponse;
    position: uint64;
}

// Method: "transport.stop"
table TransportStopRequest {}
table TransportStopResponse {
    status: StatusResponse;
}

// Method: "transport.pause"
table TransportPauseRequest {}
table TransportPauseResponse {
    status: StatusResponse;
}

// Method: "transport.set_position"
table TransportSetPositionRequest {
    tick: uint64;
}
table TransportSetPositionResponse {
    status: StatusResponse;
}

// Method: "transport.get_position"
table TransportGetPositionRequest {}
table TransportGetPositionResponse {
    tick: uint64;
}

// Method: "transport.set_tempo"
table TransportSetTempoRequest {
    bpm: float32;
}
table TransportSetTempoResponse {
    status: StatusResponse;
}

// Method: "transport.set_time_sig"
table TransportSetTimeSigRequest {
    numerator:   uint32;
    denominator: uint32;
}
table TransportSetTimeSigResponse {
    status: StatusResponse;
}

// Method: "transport.set_loop"
table TransportSetLoopRequest {
    start_tick: uint64;
    end_tick:   uint64;
}
table TransportSetLoopResponse {
    status: StatusResponse;
}

// Method: "transport.get_state"
table TransportGetStateRequest {}
table TransportGetStateResponse {
    state:    TransportState;
    position: uint64;
}

